# Copy to .env for `task run` and `task test:integration`. .env is gitignored.

# --- Kroger developer app (required) ---
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Kroger app.
# KROGER_REDIRECT_URI=http://localhost:8080/kroger/callback

# --- Shopping defaults (optional) ---
# KROGER_LOCATION_ID=
# KROGER_MODALITY=PICKUP

# Where state.json (linked account tokens, preferred store) is kept.
# KROGER_MCP_DATA_DIR=data

# Integration tests: the certification API and a zip code to search near.
# KROGER_API_BASE_URL=https://api-ce.kroger.com/v1
# KROGER_TEST_ZIP=45202

# Listen address. Defaults to 127.0.0.1:8080 (loopback only).
# KROGER_MCP_ADDR=127.0.0.1:8080

# trace, debug, info (default), warn or error.
# KROGER_MCP_LOG_LEVEL=info

# Serve without auth beyond loopback (trusted networks only).
# KROGER_MCP_ALLOW_UNAUTHENTICATED=false

# MCP auth: set an issuer to require OAuth bearer tokens on the MCP endpoint.
# KROGER_MCP_OIDC_ISSUER=https://auth.example.com
# KROGER_MCP_OIDC_RESOURCE=https://kroger-mcp.example.com
# KROGER_MCP_OIDC_SCOPES=mcp
# KROGER_MCP_OIDC_REQUIRE_AT_JWT=true
